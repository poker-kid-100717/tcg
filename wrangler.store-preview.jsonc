{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tcg-store-preview",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-25",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "preview.tcg-portfolio-sample.app",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/health",
      "/health/*"
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "containers": [
    {
      "class_name": "TcgApi",
      "image": "./backend/Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    },
    {
      "class_name": "InventoryApi",
      "image": "./inventory/Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "API",
        "class_name": "TcgApi"
      },
      {
        "name": "INVENTORY",
        "class_name": "InventoryApi"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TcgApi"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["InventoryApi"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
