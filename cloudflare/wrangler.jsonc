{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tcg-marketplace",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-21",
  "workers_dev": true,
  "routes": [
    { "pattern": "tcg.portfolio-joshdavis.app", "custom_domain": true }
  ],

  // React production build (frontend/build). Static files are served straight
  // from Cloudflare's edge; only API and health routes run the Worker.
  "assets": {
    "directory": "../frontend/build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/healthz"]
  },

  // ASP.NET Core 10 API, built from backend/Dockerfile on every deploy.
  "containers": [
    {
      "class_name": "TcgApi",
      "image": "../backend/Dockerfile",
      "image_build_context": "../backend",
      "instance_type": "basic",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "TCG_API", "class_name": "TcgApi" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TcgApi"] }],

  // Secrets (set by the deploy workflow, or `npx wrangler secret put <NAME>`):
  //   DATABASE_URL     Npgsql connection string for the managed Postgres
  //   JWT_SIGNING_KEY  >= 32-byte HMAC key for issuing/validating JWTs
  "observability": { "enabled": true }
}
