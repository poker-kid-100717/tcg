{
  "name": "pokemon-tcg-marketplace-edge",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker that serves the React frontend and routes /api to the ASP.NET Core container.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:frontend": "npm run build --prefix frontend",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261124.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7"
  }
}
