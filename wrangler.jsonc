{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tcg",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-25",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "tcg-portfolio-sample.app",
      "custom_domain": true
    },
    {
      "pattern": "www.tcg-portfolio-sample.app",
      "custom_domain": true
    }
  ],
  // React build served from the edge; /api/* and /health go to the Worker,
  // which forwards them to the .NET container. /internal/* is never forwarded.
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/health",
      "/health/*"
    ]
  },
  "containers": [
    {
      "class_name": "TcgApi",
      "image": "./backend/Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "API",
        "class_name": "TcgApi"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "TcgApi"
      ]
    }
  ],
  // Record TCGplayer prices once a day (worker/index.ts → scheduled).
  "triggers": {
    "crons": ["15 11 * * *", "45 11 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
